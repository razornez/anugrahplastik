# PostgreSQL untuk lingkungan lokal atau server.
DATABASE_URL="postgresql://anugrahplastik:ubah-sandi-anda@127.0.0.1:5432/anugrahplastik"

# Dibutuhkan agar sesi admin dapat diverifikasi. Gunakan nilai panjang dan acak.
AUTH_SECRET="ganti-dengan-rahasia-panjang-minimal-32-karakter"

# Origin publik aplikasi untuk validasi upload, terutama di belakang reverse proxy.
# Opsional lokal; produksi contoh: https://admin.anugrahplastik.com (tanpa path/query).
APP_ORIGIN=""

# Digunakan sekali untuk membuat administrator pertama setelah migrasi database.
INITIAL_ADMIN_EMAIL="admin@anugrahplastik.com"
INITIAL_ADMIN_PASSWORD="ganti-dengan-kata-sandi-awal-yang-kuat"

# Khusus pengembangan lokal. Jangan aktifkan pada server production.
LOCAL_ADMIN_AUTOFILL="false"
# Hanya lokal: nomor WhatsApp milik Anda untuk mencoba prospek demo (format 08... atau 62...).
DEMO_WHATSAPP_TEST_NUMBER=""

# Jalankan satu worker terpisah untuk meringkas batch perilaku pengunjung.
ANALYTICS_WORKER_POOL_MAX="2"
ANALYTICS_WORKER_POLL_MS="1000"

# Direktori privat di VPS. Jangan letakkan di dalam public/.
PRIVATE_STORAGE_PATH="/var/lib/anugrahplastik/private"

# Generate a unique 32-byte key (64 hex characters) for encrypted integration credentials.
INTEGRATIONS_ENCRYPTION_KEY=""

# Endpoint cPanel/Hostinger untuk Email CS. Isi dari halaman cPanel “Set Up Mail Client”.
# Contoh shared-hosting saat ini: srv145.niagahoster.com. Jangan memakai host web VPS bila mailbox berada di cPanel.
CS_MAIL_HOST=""
CS_MAIL_IMAP_PORT="993"
CS_MAIL_SMTP_PORT="465"

# Google Ads OAuth (server-only; use separate local/testing and production clients).
# Production consent uses HTTPS, the verified Anugrah Plastik domain, and the exact redirect URI below.
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
# Required by every Google Ads API request. Keep it only in the server secret store.
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Target ad-serving account and its linked active Manager/MCC account. Both are exactly 10 digits without hyphens.
GOOGLE_ADS_CUSTOMER_ID="6738895829"
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# The sole owner account permitted to complete the OAuth consent flow.
GOOGLE_ADS_LOGIN_EMAIL="razornez@gmail.com"
GOOGLE_ADS_REDIRECT_URI="http://localhost:3100/api/integrations/google-ads/callback"

# Protect the scheduled sync endpoint; configure the scheduler on the VPS.
INTEGRATIONS_CRON_TOKEN=""
# Public HTTPS origin used only by the VPS scheduler runner; never include a secret in this value.
INTEGRATIONS_SYNC_URL="https://anugrahplastik.com"

# Audit SEO organik: konfigurasi privat. Cron belum diaktifkan di produksi.
SERPAPI_API_KEY=""
GROWTH_AUDIT_CRON_TOKEN=""

# DocGen: template contoh dan resmi memakai ID terpisah; lihat docs/RUNBOOK.md.
# Jangan menaruh nilai rahasia ini di chat atau repository.
DOCGEN_API_KEY=""
DOCGEN_TEMPLATE_MODE="dummy"
DOCGEN_TEMPLATE_QUOTATION_ID=""
DOCGEN_QUOTATION_TEMPLATE_READY="no"
DOCGEN_TEMPLATE_INVOICE_ID=""
DOCGEN_TEMPLATE_DELIVERY_ID=""
DOCGEN_DELIVERY_TEMPLATE_READY="no"
DOCGEN_TEMPLATE_BAST_ID=""
DOCGEN_BAST_TEMPLATE_READY="no"
DOCGEN_OFFICIAL_RELEASE_APPROVED="no"
DOCGEN_OFFICIAL_INVOICE_APPROVED="no"
DOCGEN_OFFICIAL_TEMPLATE_QUOTATION_ID=""
DOCGEN_OFFICIAL_TEMPLATE_INVOICE_ID=""
DOCGEN_OFFICIAL_TEMPLATE_DELIVERY_ID=""
DOCGEN_OFFICIAL_TEMPLATE_BAST_ID=""
# Email CS defaults to simulation locally; live sending requires separate approval.
EMAIL_CS_SEND_MODE=simulate
# Comma-separated private test addresses, only used for approved live tests outside production.
EMAIL_CS_TEST_RECIPIENTS=

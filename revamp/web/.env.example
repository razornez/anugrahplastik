# PostgreSQL untuk lingkungan lokal atau server.
DATABASE_URL="postgresql://anugrahplastik:ubah-sandi-anda@127.0.0.1:5432/anugrahplastik"

# Dibutuhkan agar sesi admin dapat diverifikasi. Gunakan nilai panjang dan acak.
AUTH_SECRET="ganti-dengan-rahasia-panjang-minimal-32-karakter"

# Digunakan sekali untuk membuat administrator pertama setelah migrasi database.
INITIAL_ADMIN_EMAIL="admin@anugrahplastik.com"
INITIAL_ADMIN_PASSWORD="ganti-dengan-kata-sandi-awal-yang-kuat"

# Khusus pengembangan lokal. Jangan aktifkan pada server production.
LOCAL_ADMIN_AUTOFILL="false"

# Jalankan satu worker terpisah untuk meringkas batch perilaku pengunjung.
ANALYTICS_WORKER_POOL_MAX="2"
ANALYTICS_WORKER_POLL_MS="1000"

# Direktori privat di VPS. Jangan letakkan di dalam public/.
PRIVATE_STORAGE_PATH="/var/lib/anugrahplastik/private"

# Generate a unique 32-byte key (64 hex characters) for encrypted integration credentials.
INTEGRATIONS_ENCRYPTION_KEY=""

# Google Ads API OAuth app credentials (server-only; never expose with NEXT_PUBLIC_).
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_CUSTOMER_ID="6738895829"
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_LOGIN_EMAIL="razornez@gmail.com"
GOOGLE_ADS_REDIRECT_URI="http://localhost:3100/api/integrations/google-ads/callback"

# Protect the scheduled sync endpoint; configure the scheduler on the VPS.
INTEGRATIONS_CRON_TOKEN=""
